# What `pane-deps.sh` fetches. Pinned by `v8/DEPS` and 43 MB, so it is fetched
# rather than carried -- the same rule that keeps this fork out of the embedder's
# repository.
/third_party/icu/common/*.dat
/third_party/rust/chromium_crates_io/

# What the crate's own build scripts download into the tree.
/third_party/rust-toolchain/

# A build run from inside this tree rather than from the embedder's workspace, which is
# what `cargo test` here does.
/target/
/out/

__pycache__/
*.pyc
